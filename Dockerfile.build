FROM ubuntu:22.04
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake libopenmpi-dev zlib1g-dev flex libfl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY CMakeLists.txt .
COPY vendor/ vendor/

RUN cmake -B build -DCMAKE_BUILD_TYPE=Release . \
    && cmake --build build --parallel 4 2>&1 | tee /build/build.log \
    && echo "=== BUILD OK ===" \
    && ls -lh build/simpleFoamExtracted
